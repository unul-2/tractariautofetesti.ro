# Google Ads: complete only after the conversion actions are verified in Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
# Only for the temporary Netlify demo. Never enable on the public site.
NEXT_PUBLIC_ADMIN_DEMO_ENABLED=false

# Google Places API (New): used only by the Netlify server function.
# Never prefix this variable with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
# Optional. If empty, the server verifies and stores only the Google Place ID on its first successful lookup.
GOOGLE_PLACE_ID=

# Aggregated site interaction data is deleted automatically after this many days.
ANALYTICS_RETENTION_DAYS=90


# Google Ads Admin connector (server-side only; never use NEXT_PUBLIC_).
# Read-only dashboard stays safe even when GOOGLE_ADS_WRITE_ENABLED=false.
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional: required when OAuth authenticates through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Second security layer for Ads mutations.
# Keep these only in Netlify environment variables, never commit real values.
ADS_EDIT_PIN=
# Use a random secret of at least 32 characters.
ADS_EDIT_SESSION_SECRET=
# Safety kill-switch. Keep false until write operations are intentionally activated.
GOOGLE_ADS_WRITE_ENABLED=false
